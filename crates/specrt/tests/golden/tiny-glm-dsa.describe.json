{
  "name": "glm_moe_dsa",
  "repo": "",
  "quant": "bf16",
  "dims": {
    "hidden": 256,
    "intermediate": 512,
    "vocab": 512,
    "tie_embeddings": false
  },
  "layers": {
    "count": 2,
    "pattern": [
      "full"
    ]
  },
  "norm": {
    "kind": "rmsnorm",
    "eps": 1e-6
  },
  "attention": {
    "kind": "dsa",
    "heads": 4,
    "kv_heads": 4,
    "head_dim": 32,
    "qkv_bias": false,
    "qk_norm": false,
    "indexer": {
      "heads": 8,
      "head_dim": 64,
      "topk": 8
    }
  },
  "rope": {
    "style": "neox",
    "theta": 10000.0
  },
  "mlp": {
    "activation": "swiglu"
  },
  "moe": {
    "experts": 8,
    "active": 2,
    "expert_intermediate": 256,
    "shared_intermediate": 256,
    "dense_layers": [
      0,
      1
    ],
    "routed_scale": 2.5
  }
}