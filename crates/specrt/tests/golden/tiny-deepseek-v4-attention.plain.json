          "rows"
        ],
        "bind": {
          "comp": {
            "state": "comp"
          },
          "k_cache": {
            "state": "kv"
          },
          "out": {
            "buffer": "o_heads"
          },
          "qh": {
            "buffer": "q_heads"
          },
          "ratio": "hca_ratio",
          "sinks": {
            "weight": "sinks",
            "len": "heads"
          },
          "softmax_scale": "softmax_scale",
          "v_cache": {
            "state": "kv"
