          "heads",
          "rows"
        ],
        "bind": {
          "x": {
            "buffer": "q_heads"
          }
        }
      },
      {
        "op": "kernel",
        "kernel": "v4_kv_rope",
        "grid": [
          "1",
          "rows"
        ],
        "bind": {
          "x": {
            "buffer": "qkv"
          }
        }
      },
      {
        "op": "kernel",
        "kernel": "v4_kv_write",
        "grid": [
          "1",
          "rows"
