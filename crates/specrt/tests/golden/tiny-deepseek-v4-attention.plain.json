        "op": "kernel",
        "kernel": "v4_csa_pool",
        "grid": [
          "1",
          "rows"
        ],
        "bind": {
          "bias": {
            "weight": "compressor.position_bias",
            "len": "csa_ratio * 2 * head_dim"
