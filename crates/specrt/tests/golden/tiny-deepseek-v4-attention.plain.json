{
  "name": "deepseek_v4_attention",
  "repo": "",
  "quant": "bf16",
  "dims": {
    "hidden": 256,
    "intermediate": 512,
    "vocab": 512,
    "tie_embeddings": false
  },
  "layers": {
    "count": 3,
    "pattern": [
      "compressed",
      "indexed",
      "sliding"
    ],
    "window": 16
  },
  "norm": {
    "kind": "rmsnorm",
    "eps": 1e-6
  },
  "attention": {
    "kind": "gqa",
    "heads": 4,
    "kv_heads": 1,
    "head_dim": 64,
    "qkv_bias": false,
    "qk_norm": false,
    "rotary_dim": 16,
    "node": [
      {
        "op": "kernel",
        "kernel": "v4_q_a_norm",
        "grid": [
          "rows"
        ],
        "bind": {
          "out": {
            "buffer": "qkv"
          },
          "weight": {
            "weight": "q_a_norm.weight",
            "len": "q_lora_rank"
          },
          "x": {
            "buffer": "qkv"
          }
        }
      },
      {
        "op": "kernel",
        "kernel": "v4_kv_norm",
        "grid": [
          "rows"
        ],
        "bind": {
          "out": {
            "buffer": "qkv"
          },
          "weight": {
            "weight": "kv_norm.weight",
            "len": "head_dim"
          },
          "x": {
            "buffer": "qkv"
          }
        }
      },
      {
        "op": "kernel",
        "kernel": "v4_q_matvec",
        "grid": [
          "heads",
          "rows"
        ],
        "bind": {
          "w": {
            "weight": "q_b_proj.weight",
