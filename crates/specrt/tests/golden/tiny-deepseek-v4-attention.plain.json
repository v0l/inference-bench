    ],
    "params": {
      "csa_ratio": 4.0,
      "hca_ratio": 8.0,
      "index_head_dim": 32.0,
      "index_heads": 16.0,
      "index_scale": 0.17677669529663687,
      "index_topk": 3.0,
      "index_w_scale": 0.25,
      "o_groups": 2.0,
      "o_lora_rank": 32.0,
      "q_lora_rank": 64.0,
      "softmax_scale": 0.125
    },
    "projection": [
      {
        "tensor": "q_a_proj",
        "rows": "q_lora_rank"
      },
      {
        "tensor": "kv_proj",
        "rows": "head_dim"
      },
      {
        "tensor": "compressor.kv_proj",
        "rows": "head_dim",
        "layers": [
          "compressed"
        ]
      },
      {
        "tensor": "compressor.gate_proj",
        "rows": "head_dim",
        "layers": [
          "compressed"
        ]
      },
      {
        "tensor": "compressor.kv_proj",
        "rows": "2 * head_dim",
        "layers": [
          "indexed"
        ]
      },
      {
        "tensor": "compressor.gate_proj",
        "rows": "2 * head_dim",
        "layers": [
          "indexed"
        ]
      },
      {
        "tensor": "compressor.indexer.kv_proj",
        "rows": "2 * index_head_dim",
        "layers": [
          "indexed"
        ]
      },
      {
        "tensor": "compressor.indexer.gate_proj",
        "rows": "2 * index_head_dim",
        "layers": [
          "indexed"
        ]
      },
      {
        "tensor": "compressor.indexer.scorer.weights_proj",
        "rows": "index_heads",
        "layers": [
          "indexed"
        ]
      }
    ],
    "o_cols": "o_groups * o_lora_rank",
    "scratch": {
      "iq": "index_heads * index_head_dim",
      "o_heads": "heads * head_dim",
      "q_heads": "heads * head_dim"
    },
    "int_scratch": {
      "idx": "index_topk"
    },
    "o_tensor": "o_b_proj"
  },
  "rope": {
    "style": "neox",
    "theta": 160000.0,
    "local_theta": 10000.0
  },
  "mlp": {
    "activation": "swiglu"
  },
  "state": [
    {
