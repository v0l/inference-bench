        "layers": [
          "indexed"
        ]
      },
      {
        "op": "kernel",
        "kernel": "v4_idx_topk",
        "grid": [
          "1",
          "rows"
        ],
        "bind": {
          "idx": {
            "buffer": "idx"
          },
          "keys": {
            "state": "comp_i"
          },
          "q": {
            "buffer": "iq"
          },
          "ratio": "csa_ratio",
          "scale": "index_scale",
          "w": {
            "buffer": "qkv"
          },
          "w_scale": "index_w_scale"
        },
        "layers": [
          "indexed"
        ]
      },
      {
        "op": "kernel",
        "kernel": "v4_csa_attn",
        "grid": [
          "heads",
          "rows"
        ],
        "bind": {
          "comp": {
            "state": "comp"
          },
          "idx": {
            "buffer": "idx"
          },
          "k_cache": {
            "state": "kv"
          },
          "out": {
            "buffer": "o_heads"
          },
          "qh": {
            "buffer": "q_heads"
          },
          "ratio": "csa_ratio",
          "sinks": {
            "weight": "sinks",
            "len": "heads"
          },
          "softmax_scale": "softmax_scale",
          "v_cache": {
            "state": "kv"
          },
          "window": "window"
        },
        "layers": [
          "indexed"
        ]
      },
      {
        "op": "kernel",
        "kernel": "v4_swa_attn",
        "grid": [
          "heads",
          "rows"
        ],
        "bind": {
          "k_cache": {
            "state": "kv"
          },
          "out": {
            "buffer": "o_heads"
          },
          "qh": {
            "buffer": "q_heads"
          },
          "sinks": {
            "weight": "sinks",
            "len": "heads"
          },
          "softmax_scale": "softmax_scale",
          "v_cache": {
            "state": "kv"
          },
          "window": "window"
        },
        "layers": [
          "sliding"
        ]
      },
      {
        "op": "kernel",
        "kernel": "v4_o_rope",
