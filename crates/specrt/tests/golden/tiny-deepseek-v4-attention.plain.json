          },
          "norm": {
            "weight": "compressor.kv_norm.weight",
            "len": "head_dim"
          },
          "overlap": 1.0,
          "ratio": "csa_ratio",
          "raw": {
            "state": "raw"
          }
        },
        "layers": [
          "indexed"
        ]
      },
      {
        "op": "kernel",
        "kernel": "v4_idx_raw_write",
        "grid": [
          "1",
          "rows"
