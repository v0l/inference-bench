      {
        "op": "kernel",
        "kernel": "v4_hca_pool",
        "grid": [
          "1",
          "rows"
        ],
        "bind": {
          "bias": {
            "weight": "compressor.position_bias",
            "len": "hca_ratio * head_dim"
