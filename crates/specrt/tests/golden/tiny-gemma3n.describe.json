{
  "name": "gemma3n_text",
  "repo": "",
  "quant": "bf16",
  "dims": {
    "hidden": 128,
    "intermediate": 256,
    "vocab": 512,
    "tie_embeddings": true,
    "logit_softcap": 30.0
  },
  "layers": {
    "count": 4,
    "pattern": [
      "sliding",
      "full"
    ],
    "window": 16
  },
  "norm": {
    "kind": "rmsnorm",
    "eps": 1e-6
  },
  "attention": {
    "kind": "gqa",
    "heads": 4,
    "kv_heads": 1,
    "head_dim": 32,
    "qkv_bias": false,
    "qk_norm": false
  },
  "rope": {
    "style": "neox",
    "theta": 1000000.0,
    "local_theta": 10000.0
  },
  "mlp": {
    "activation": "geglu"
  }
}