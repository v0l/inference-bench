{
  "name": "glm_moe_dsa",
  "repo": "",
  "quant": "bf16",
  "dims": {
    "hidden": 256,
    "intermediate": 512,
    "vocab": 512,
    "tie_embeddings": false
  },
  "layers": {
    "count": 2,
    "pattern": [
      "full",
      "shared"
    ]
  },
  "norm": {
    "kind": "rmsnorm",
    "eps": 1e-6
  },
  "attention": {
    "kind": "gqa",
    "heads": 4,
    "kv_heads": 4,
    "head_dim": 32,
    "qkv_bias": false,
    "qk_norm": false,
    "node": [
      {
        "op": "kernel",
        "kernel": "dsa_q_norm",
        "grid": [
          "rows"
        ],
        "bind": {
          "out": {
            "buffer": "qkv"
          },
          "weight": {
            "weight": "q_a_layernorm.weight",
            "len": "q_lora_rank"
          },
          "x": {
            "buffer": "qkv"
          }
        }
      },
      {
        "op": "kernel",
        "kernel": "dsa_latent_norm",
        "grid": [
          "rows"
        ],
        "bind": {
          "out": {
            "buffer": "qkv"
          },
          "weight": {
            "weight": "kv_a_layernorm.weight",
            "len": "kv_lora_rank"
          },
          "x": {
            "buffer": "qkv"
          }
        }
      },
      {
        "op": "kernel",
        "kernel": "dsa_q_b",
        "grid": [
          "1",
          "rows"
        ],
        "bind": {
          "w": {
            "weight": "q_b_proj.weight",
            "len": "q_lora_rank * heads * (qk_nope_head_dim + qk_rope_head_dim)"
          },
          "x": {
            "buffer": "qkv"
          },
          "y": {
            "buffer": "qr"
          }
        }
      },
      {
        "op": "kernel",
        "kernel": "dsa_rope_q",
        "grid": [
          "heads",
          "rows"
        ],
        "bind": {
          "x": {
            "buffer": "qr"
          }
        }
      },
      {
        "op": "kernel",
        "kernel": "dsa_rope_k",
        "grid": [
          "1",
          "rows"
        ],
        "bind": {
          "x": {
            "buffer": "qkv"
          }
        }
      },
      {
        "op": "kernel",
        "kernel": "dsa_latent_write",
        "grid": [
          "1",
          "rows"
        ],
        "bind": {
          "dst": {
            "state": "latent"
          },
          "src": {
            "buffer": "qkv"
          }
        }
      },
      {
        "op": "kernel",
        "kernel": "dsa_absorb_q",
        "grid": [
          "heads",
          "rows"
        ],
        "bind": {
          "w": {
            "weight": "kv_b_proj.weight",
            "len": "heads * (qk_nope_head_dim + v_head_dim) * kv_lora_rank"
          },
          "x": {
            "buffer": "qr"
          },
          "y": {
            "buffer": "q_latent"
          }
        }
      },
      {
        "op": "kernel",
        "kernel": "dsa_index_q",
        "grid": [
          "1",
          "rows"
        ],
        "bind": {
          "w": {
            "weight": "indexer.wq_b.weight",
            "len": "q_lora_rank * index_q_row"
          },
          "x": {
            "buffer": "qkv"
          },
          "y": {
            "buffer": "index_q"
          }
        },
        "layers": [
          "full"
        ]
      },
      {
        "op": "kernel",
        "kernel": "dsa_index_rope_q",
        "grid": [
          "index_heads",
          "rows"
        ],
        "bind": {
          "x": {
            "buffer": "index_q"
          }
        },
        "layers": [
          "full"
        ]
      },
      {
        "op": "kernel",
        "kernel": "dsa_index_k_norm",
        "grid": [
          "1",
          "rows"
        ],
        "bind": {
          "b": {
            "weight": "indexer.k_norm.bias",
            "len": "index_head_dim"
          },
          "w": {
            "weight": "indexer.k_norm.weight",
            "len": "index_head_dim"
          },
          "x": {
            "buffer": "qkv"
          }
        },
        "layers": [
          "full"
        ]
      },
      {
        "op": "kernel",
        "kernel": "dsa_index_rope_k",
        "grid": [
          "1",
          "rows"
        ],
        "bind": {
          "x": {
            "buffer": "qkv"
          }
        },
        "layers": [
          "full"
        ]
      },
      {
        "op": "kernel",
        "kernel": "dsa_index_write",
        "grid": [
          "1",
          "rows"
        ],
        "bind": {
          "dst": {
            "state": "index_key"
          },
          "src": {
            "buffer": "qkv"
          }
        },
        "layers": [
          "full"
        ]
      },
      {
        "op": "kernel",
        "kernel": "dsa_index_topk",
        "grid": [
          "1",
          "rows"
        ],
        "bind": {
          "idx": {
            "buffer": "index_buf"
          },
          "keys": {
            "state": "index_key"
          },
          "q": {
            "buffer": "index_q"
          },
          "scale": "index_scale",
          "w": {
            "buffer": "qkv"
          },
          "w_scale": "index_w_scale"
        },
        "layers": [
          "full"
        ]
      },
      {
        "op": "kernel",
        "kernel": "dsa_attention",
        "grid": [
          "heads",
          "rows"
        ],
        "bind": {
          "idx": {
            "buffer": "index_buf"
          },
          "k_cache": {
            "state": "latent"
          },
          "out": {
            "buffer": "o_latent"
          },
          "q_latent": {
            "buffer": "q_latent"
          },
          "qr": {
            "buffer": "qr"
          },
          "softmax_scale": "softmax_scale",
          "v_cache": {
            "state": "latent"
          }
        }
      },
      {
        "op": "kernel",
        "kernel": "mla_expand_v",
        "grid": [
          "heads",
          "rows"
        ],
        "bind": {
          "w": {
            "weight": "kv_b_proj.weight",
            "len": "heads * (qk_nope_head_dim + v_head_dim) * kv_lora_rank"
          },
          "x": {
            "buffer": "o_latent"
          }
        }
      }
    ],
    "params": {
      "index_head_dim": 64.0,
      "index_heads": 8.0,
      "index_q_row": 512.0,
      "index_scale": 0.125,
      "index_topk": 8.0,
      "index_w_offset": 256.0,
      "index_w_scale": 0.35355339059327373,
      "kv_lora_rank": 96.0,
      "mscale_all_dim": 0.0,
      "q_lora_rank": 64.0,
      "qk_nope_head_dim": 32.0,
      "qk_rope_head_dim": 32.0,
      "softmax_scale": 0.125,
      "v_head_dim": 64.0,
      "yarn_factor": 1.0,
      "yarn_mscale": 1.0
    },
    "projection": [
      {
        "tensor": "q_a_proj",
        "rows": "q_lora_rank"
      },
      {
        "tensor": "kv_a_proj_with_mqa",
        "rows": "kv_lora_rank + qk_rope_head_dim"
      },
      {
        "tensor": "indexer.wk",
        "rows": "index_head_dim",
        "layers": [
          "full"
        ]
      },
      {
        "tensor": "indexer.weights_proj",
        "rows": "index_heads",
        "layers": [
          "full"
        ]
      }
    ],
    "o_cols": "heads * v_head_dim",
    "scratch": {
      "index_q": "index_q_row",
      "o_latent": "heads * kv_lora_rank",
      "q_latent": "heads * kv_lora_rank",
      "qr": "heads * (qk_nope_head_dim + qk_rope_head_dim)"
    },
    "int_scratch": {
      "index_buf": "index_topk"
    }
  },
  "rope": {
    "style": "neox",
    "theta": 10000.0
  },
  "mlp": {
    "activation": "swiglu"
  },
  "moe": {
    "experts": 8,
    "active": 2,
    "expert_intermediate": 256,
    "shared_intermediate": 256,
    "dense_layers": [
      0,
      1
    ],
    "router": "sigmoid",
    "shared_module": "shared_experts",
    "routed_scale": 2.5,
    "score_bias": true
  },
  "state": [
    {
      "name": "latent",
      "per": "token",
      "layers": "attention",
      "shape": [
        "1",
        "kv_lora_rank + qk_rope_head_dim"
      ],
      "dtype": "bf16",
      "snapshot": true,
      "prefix_share": true,
      "rollback": "positional"
    },
    {
      "name": "index_key",
      "per": "token",
      "layers": "attention",
      "shape": [
        "1",
        "index_head_dim"
      ],
      "dtype": "bf16",
      "snapshot": true,
      "prefix_share": true,
      "rollback": "positional"
    }
  ]
}