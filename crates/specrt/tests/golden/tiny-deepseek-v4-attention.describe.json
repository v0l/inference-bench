{
  "name": "deepseek_v4_attention",
  "repo": "",
  "quant": "bf16",
  "dims": {
    "hidden": 256,
    "intermediate": 512,
    "vocab": 512,
    "tie_embeddings": false
  },
  "layers": {
    "count": 3,
    "pattern": [
      "full",
      "full",
      "sliding"
    ],
    "window": 16
  },
  "norm": {
    "kind": "rmsnorm",
    "eps": 1e-6
  },
  "attention": {
    "kind": "gqa",
    "heads": 4,
    "kv_heads": 1,
    "head_dim": 64,
    "qkv_bias": false,
    "qk_norm": false,
    "rotary_dim": 16,
    "indexer": {
      "heads": 16,
      "head_dim": 32,
      "topk": 3
    }
  },
  "rope": {
    "style": "neox",
    "theta": 10000.0
  },
  "mlp": {
    "activation": "swiglu"
  },
  "moe": {
    "experts": 4,
    "active": 2,
    "expert_intermediate": 512,
    "shared_intermediate": 512,
    "routed_scale": 1.5
  },
  "hyper": {
    "streams": 2,
    "sinkhorn_iters": 20,
    "eps": 1e-6
  }
}