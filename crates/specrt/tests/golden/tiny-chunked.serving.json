{
  "name": "chunked_smollm3",
  "repo": "",
  "quant": "bf16",
  "dims": {
    "hidden": 128,
    "intermediate": 256,
    "vocab": 512,
    "tie_embeddings": false
  },
  "layers": {
    "count": 4,
    "pattern": [
      "sliding",
      "full"
    ],
    "window": 16
  },
  "norm": {
    "kind": "rmsnorm",
    "eps": 1e-6
  },
  "attention": {
    "kind": "gqa",
    "heads": 4,
    "kv_heads": 2,
    "head_dim": 32,
    "qkv_bias": false,
    "qk_norm": false,
    "node": [
      {
        "op": "qk_rope",
        "phase": "prefill"
      },
      {
        "op": "kernel",
        "kernel": "attn_chunked",
        "grid": [
          "heads",
          "rows"
        ],
        "bind": {
          "attn_scale": "attn_scale",
          "chunk": "window",
          "floor_scale": "floor_scale",
          "nope": "nope",
          "tuning": "tuning"
        },
        "phase": "prefill"
      },
      {
        "op": "decode_rope",
        "phase": "rows"
      },
      {
        "op": "kernel",
        "kernel": "attn_chunked",
        "grid": [
          "heads",
          "rows"
        ],
        "bind": {
          "attn_scale": "attn_scale",
          "chunk": "window",
          "floor_scale": "floor_scale",
          "nope": "nope",
          "tuning": "tuning"
        },
        "phase": "rows"
      }
    ],
    "params": {
      "attn_scale": 0.5,
      "floor_scale": 16.0,
      "tuning": 1.0
    }
  },
  "rope": {
    "style": "neox",
    "theta": 100000.0,
    "nope_layers": [
      1,
      3
    ]
  },
  "mlp": {
    "activation": "swiglu"
  }
}