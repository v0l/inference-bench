            "weight": "k_norm.weight",
            "len": "hd_g"
          },
          "x": {
            "buffer": "qkv"
          }
        },
        "when": "kv_owner",
        "layers": [
          "full"
        ]
      },
      {
        "op": "kernel",
        "kernel": "g4_v_norm_g",
        "grid": [
          "kvh_g",
          "rows"
        ],
        "bind": {
          "x": {
            "buffer": "qkv"
          }
        },
        "when": "kv_owner",
        "layers": [
          "full"
