      {
        "op": "kernel",
        "kernel": "g4_q_rope_g",
        "grid": [
          "heads",
          "rows"
        ],
        "bind": {
          "x": {
            "buffer": "qkv"
          }
        },
        "layers": [
          "full"
        ]
      },
      {
        "op": "kernel",
        "kernel": "g4_k_rope_g",
        "grid": [
          "kvh_g",
          "rows"
        ],
        "bind": {
          "x": {
            "buffer": "qkv"
          }
        },
        "when": "kv_owner",
        "layers": [
          "full"
        ]
      },
      {
        "op": "kernel",
        "kernel": "g4_k_write_g",
        "grid": [
          "kvh_g",
          "rows"
        ],
        "bind": {
          "dst": {
            "state": "k_g"
          },
          "layer": "kind_layer",
          "src": {
            "buffer": "qkv"
