          "layer": "kind_layer",
          "src": {
            "buffer": "qkv"
          }
        },
        "when": "kv_owner",
        "layers": [
          "sliding"
        ]
      },
      {
        "op": "kernel",
        "kernel": "g4_v_write_s",
        "grid": [
          "kvh_s",
          "rows"
        ],
        "bind": {
          "dst": {
            "state": "v_s"
