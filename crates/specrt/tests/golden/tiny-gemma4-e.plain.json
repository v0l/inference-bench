      {
        "tensor": "k_proj",
        "rows": "kvh_g * hd_g",
        "kv_owner": true,
        "layers": [
          "full"
        ],
        "slot": "v_w",
        "when": "k_eq_v"
      }
    ],
    "o_cols": "q_w",
    "o_cols_by": [
      {
        "layers": [
          "sliding"
        ],
        "cols": "heads * hd_s"
      },
      {
        "layers": [
          "full"
        ],
        "cols": "heads * hd_g"
      }
    ]
