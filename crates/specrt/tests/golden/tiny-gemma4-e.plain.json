      "kvh_s": 1.0,
      "q_w": 256.0,
      "rotary_g": 0.25,
      "theta_g": 1000000.0,
      "theta_s": 10000.0,
      "v_w": 64.0
    },
    "projection": [
      {
        "tensor": "q_proj",
        "rows": "heads * hd_s",
        "layers": [
          "sliding"
        ],
        "slot": "q_w"
      },
      {
        "tensor": "q_proj",
        "rows": "heads * hd_g",
        "layers": [
          "full"
        ],
        "slot": "q_w"
