  "rope": {
    "style": "neox",
    "theta": 1000000.0,
    "local_theta": 10000.0
  },
  "mlp": {
    "activation": "geglu",
    "wide_shared_tail": true
  },
  "per_layer": {
    "dim": 16,
    "params": {
      "ple_dim": 16.0,
      "ple_embed_scale": 4.0,
      "ple_layers": 6.0,
      "ple_mix_scale": 0.7071067811865476,
      "ple_one": 1.0,
      "ple_proj_scale": 0.08838834764831843,
      "ple_vocab": 512.0,
      "ple_width": 96.0
    },
    "scratch": {
      "ple": "ple_width",
      "ple_gate": "ple_dim",
      "ple_out": "ple_dim",
      "ple_proj": "ple_width"
