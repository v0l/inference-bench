          "x": {
            "buffer": "ple_gate"
          },
          "y": {
            "buffer": "ple_out"
          }
        }
      },
      {
        "op": "layer",
        "kernel": "g4_ple_add",
        "grid": [
          "ple_one",
          "rows"
        ],
        "bind": {
          "pout": {
            "buffer": "ple_out"
          },
          "w": {
            "weight": "post_per_layer_input_norm.weight",
            "len": "hidden"
          },
          "x": {
            "buffer": "x"
          },
          "xin": {
            "buffer": "x"
          }
        }
      }
    ]
  },
  "state": [
    {
      "name": "k_s",
