          "heads",
          "rows"
        ],
        "bind": {
          "x": {
            "buffer": "qkv"
          }
        },
        "layers": [
          "sliding"
        ]
      },
      {
        "op": "kernel",
        "kernel": "g4_k_rope_s",
        "grid": [
          "kvh_s",
          "rows"
        ],
        "bind": {
          "x": {
            "buffer": "qkv"
          }
        },
        "when": "kv_owner",
        "layers": [
          "sliding"
        ]
      },
      {
        "op": "kernel",
        "kernel": "g4_k_write_s",
        "grid": [
          "kvh_s",
          "rows"
