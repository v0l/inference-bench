        ]
      },
      {
        "op": "kernel",
        "kernel": "g4_attn_s",
        "grid": [
          "heads",
          "rows"
        ],
        "bind": {
          "k_cache": {
            "state": "k_s"
          },
          "layer": "kind_layer",
          "v_cache": {
            "state": "v_s"
          },
          "window": "window"
        },
        "layers": [
          "sliding"
        ]
      },
      {
        "op": "kernel",
        "kernel": "g4_q_norm_g",
        "grid": [
