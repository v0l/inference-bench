{
  "name": "glm5_next",
  "repo": "",
  "quant": "bf16",
  "dims": {
    "hidden": 128,
    "intermediate": 256,
    "vocab": 512,
    "tie_embeddings": false
  },
  "layers": {
    "count": 4,
    "pattern": [
      "linear",
      "linear",
      "linear",
      "full"
    ]
  },
  "norm": {
    "kind": "rmsnorm",
    "eps": 0.00001
  },
  "attention": {
    "kind": "dsa",
    "heads": 4,
    "kv_heads": 4,
    "head_dim": 32,
    "qkv_bias": false,
    "qk_norm": false,
    "indexer": {
      "heads": 4,
      "head_dim": 32,
      "topk": 8,
      "kpool": 4
    }
  },
  "rope": {
    "style": "neox",
    "nope_layers": [
      0,
      1,
      2,
      3
    ]
  },
  "mlp": {
    "activation": "swiglu"
  },
  "moe": {
    "experts": 8,
    "active": 2,
    "expert_intermediate": 32,
    "shared_intermediate": 32,
    "dense_layers": [
      0
    ],
    "routed_scale": 2.5
  },
  "linear_attention": {
    "kind": "kda",
    "key_heads": 2,
    "value_heads": 2,
    "key_head_dim": 64,
    "value_head_dim": 64,
    "conv_kernel": 4
  },
  "hyper": {
    "streams": 4,
    "sinkhorn_iters": 20,
    "eps": 1e-6
  },
  "mtp": {
    "layers": 1,
    "draft_tokens": 2,
    "speculate": true
  }
}