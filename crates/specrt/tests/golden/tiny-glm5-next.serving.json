      "dtype": "f32",
      "snapshot": true,
      "prefix_share": true,
      "rollback": "checkpoint"
    },
    {
      "name": "conv_k",
      "per": "sequence",
      "layers": "linear",
      "shape": [
        "kda_qkv",
        "kda_taps - 1"
      ],
      "dtype": "f32",
      "snapshot": true,
      "prefix_share": true,
      "rollback": "checkpoint"
    },
    {
      "name": "conv_v",
      "per": "sequence",
      "layers": "linear",
      "shape": [
        "kda_qkv",
        "kda_taps - 1"
      ],
      "dtype": "f32",
      "snapshot": true,
      "prefix_share": true,
      "rollback": "checkpoint"
    },
    {
      "name": "kda",
      "per": "sequence",
      "layers": "linear",
      "shape": [
        "kda_heads",
        "kda_head_dim",
        "kda_head_dim"
      ],
      "dtype": "f32",
      "snapshot": true,
      "prefix_share": true,
      "rollback": "checkpoint"
    }
  ],
  "tensors": {
    "index_kpool_compress_gate": "kpool_gate.weight"
  }
}